{
  "name": "marpme-template",
  "version": "0.1.7",
  "private": true,
  "description": "Canonical Marp and Copier template for Marpme",
  "scripts": {
    "preview": "npx --yes @marp-team/marp-cli@4.5.0 example.md --theme-set css/company.css --theme-set css/company-dark.css --preview",
    "pdf": "npx --yes @marp-team/marp-cli@4.5.0 example.md --theme-set css/company.css --theme-set css/company-dark.css --pdf --output dist/example.pdf",
    "bundle": "npm pack --pack-destination dist"
  },
  "files": [
    "copier.yml",
    "template",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  }
}
