{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Marp: Export current deck as HTML",
      "type": "process",
      "command": "npx",
      "args": [
        "--yes",
        "@marp-team/marp-cli@latest",
        "${file}",
        "--output",
        "${fileDirname}/${fileBasenameNoExtension}.html"
      ],
      "problemMatcher": []
    },
    {
      "label": "Marp: Export current deck as PDF",
      "type": "process",
      "command": "npx",
      "args": [
        "--yes",
        "@marp-team/marp-cli@latest",
        "${file}",
        "--pdf",
        "--output",
        "${fileDirname}/${fileBasenameNoExtension}.pdf"
      ],
      "problemMatcher": []
    },
    {
      "label": "Marp: Export current deck as PPTX",
      "type": "process",
      "command": "npx",
      "args": [
        "--yes",
        "@marp-team/marp-cli@latest",
        "${file}",
        "--pptx",
        "--output",
        "${fileDirname}/${fileBasenameNoExtension}.pptx"
      ],
      "problemMatcher": []
    },
    {
      "label": "Marp: Export current deck in all formats",
      "dependsOn": [
        "Marp: Export current deck as HTML",
        "Marp: Export current deck as PDF",
        "Marp: Export current deck as PPTX"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Marp: Preview current deck",
      "type": "process",
      "command": "npx",
      "args": [
        "--yes",
        "@marp-team/marp-cli@latest",
        "${file}",
        "--preview"
      ],
      "problemMatcher": []
    }
  ]
}
