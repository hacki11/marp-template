{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Marp: Export current deck as PDF",
      "type": "process",
      "command": "npx",
      "args": [
        "--yes",
        "@marp-team/marp-cli@4.5.0",
        "${file}",
        "--theme-set",
        "${workspaceFolder}/.marpme/themes/company.css",
        "--theme-set",
        "${workspaceFolder}/.marpme/themes/company-dark.css",
        "--pdf",
        "--output",
        "${fileDirname}/${fileBasenameNoExtension}.pdf"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Marp: Preview current deck",
      "type": "process",
      "command": "npx",
      "args": [
        "--yes",
        "@marp-team/marp-cli@4.5.0",
        "${file}",
        "--theme-set",
        "${workspaceFolder}/.marpme/themes/company.css",
        "--theme-set",
        "${workspaceFolder}/.marpme/themes/company-dark.css",
        "--preview"
      ],
      "problemMatcher": []
    }
  ]
}
